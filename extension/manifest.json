{
  "manifest_version": 3,
  "name": "Haystack Clipper",
  "version": "0.2.0",
  "description": "Archive and parse the current page into your Haystack project.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.convex.site/*"],
  "externally_connectable": {
    "matches": [
      "https://glorious-warbler-976.convex.site/*",
      "http://localhost/*"
    ]
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip this page",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html"
}
