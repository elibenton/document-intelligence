# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# React Router framework mode: `build/` replaced `dist/` as the output dir, and
# `.react-router/` holds the generated per-route types that `react-router
# typegen` rewrites on every build.
build
.react-router

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Scan bench: real documents and their results stay local — one variant alone
# is 21MB. Only test-corpus/README.md is tracked. (The variants/ tree was
# generated by scripts/make-variants.ts, which no longer exists in the repo, so
# the local corpus is NOT reproducible from source.)
test-corpus/**/*.pdf
test-corpus/results/
test-corpus/variants/manifest.json
# Belt and braces: uploaded/ is a download cache keyed on document id, and a
# display name with a suffix after the extension once produced "<id>.pdf [bench]"
# filenames that slipped past the glob above.
test-corpus/uploaded/
public/__bench-*.pdf

# Local audio fixtures for the recording pipeline.
*.mp3
