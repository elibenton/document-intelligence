{
  "id": "/",
  "name": "Haystack",
  "short_name": "Haystack",
  "description": "Anything in. Answers out. Upload PDFs, CSVs, images, and recordings — every source parsed, entities and relationships extracted, answers cited back to the page.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
